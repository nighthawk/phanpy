{
  "name": "phanpy",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/oauth/*", "/nodeinfo/*", "/.well-known/*"],
  },
  // Wrangler creates this on the first deploy and writes its ID back here.
  "kv_namespaces": [{ "binding": "MICROBLOG_KV" }],
  // Micro.blog usernames allowed to sign in, comma-separated. Empty allows anyone.
  "vars": { "MICROBLOG_ALLOWED_USERS": "nighthawk,manton" },
  "previews": {},
}
